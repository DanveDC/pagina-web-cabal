# ─── Cabal Corretaje — environment ─────────────────────────────────────────
# Copy to `.env.local` for local dev:  cp env.example .env.local
# In production (DigitalOcean) set these as app-level env vars / secrets.
# Never commit real values.

# ── Public (shipped to the browser — NOT secret) ──────────────────────────
# "true" once Seguros Caracas has issued broker credentials and the proxy is
# fully wired. Controls whether the /cotizar form enables the live calls.
NEXT_PUBLIC_SC_ENABLED=false

# ── Seguros Caracas proxy (server-only) ───────────────────────────────────
# Upstream host. Test: https://sasweb-test.seguroscaracas.com
# Prod:  (host provided by Seguros Caracas)
SC_BASE_URL=https://sasweb-test.seguroscaracas.com

# Broker credentials issued by Seguros Caracas. Injected server-side by the
# proxy; the browser never receives them.
SC_PRODUCTOR=
SC_CONVENIO=

# Shared secret required to call the sensitive proxy operations
# (POST /suscribir and GET /cliente). Generate: openssl rand -hex 32
SC_PROXY_TOKEN=

# Master switch for the proxy. "false" -> every SC route returns 503.
SC_PROXY_ENABLED=false

# Upstream timeout (ms) and max buffered response size (bytes).
SC_TIMEOUT_MS=12000
SC_MAX_RESPONSE_BYTES=2000000

# ── API hardening ────────────────────────────────────────────────────────
# Comma-separated origins allowed to call our API routes. REQUIRED in prod.
# Catalog routes (listas/ciudades/sectores/propuestas) require a request whose
# Origin/Referer matches this list; requests with neither header are rejected.
# e.g. https://cabalasesores.com,https://www.cabalasesores.com
ALLOWED_ORIGINS=

# Header the trusted proxy in front of the app uses to convey the real client
# IP (used for rate-limit keying). DigitalOcean App Platform: do-connecting-ip.
# Behind nginx: x-real-ip. If the app has NO proxy in front, set this empty.
IP_HEADER=do-connecting-ip

# Rate limits (per client IP, fixed window).
RL_WINDOW_MS=60000
RL_CATALOG_MAX=60
RL_SENSITIVE_MAX=10

# ── MCP (Claude Desktop agent access) ───────────────────────────────────────
# Secret token for the /api/mcp gateway used by the cabal-mcp server.
# Generate: openssl rand -hex 32
# Must match MCP_TOKEN in the Claude Desktop MCP config (see cabal-mcp/README.md).
MCP_TOKEN=
