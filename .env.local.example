# ─── CABAL ASESORES — Variables de Entorno ───────────────────────────────────
# Copia este archivo como .env.local y completa los valores

# Servidor local de la oficina (LAN)
NEXT_PUBLIC_LOCAL_SERVER_URL=http://192.168.1.100:3001

# APIs de aseguradoras (solo server-side, nunca expongas en cliente)
SEGUROS_CARACAS_API_KEY=
MAPFRE_API_KEY=
LA_VENEZOLANA_API_KEY=

# Base de datos (si se conecta directamente)
DATABASE_URL=

# Auth (para el portal de clientes)
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://cabalasesores.com
